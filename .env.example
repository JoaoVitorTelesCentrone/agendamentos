# Copy to .env at repository root. Keep secrets in deploy/secrets, not here.
POSTGRES_DB=vivio
POSTGRES_USER=vivio
WEB_PORT=3000
DOMAIN=agenda.example.com
APP_URL=https://agenda.example.com

# Optional: enables account recovery e-mails through Resend.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM=AgendaFlow <contato@agenda.example.com>
# Configure um preço recorrente do Stripe e o webhook /api/stripe/webhook.
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxx
# STRIPE_PRO_PRICE_ID=price_xxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx

# Optional: required for real WhatsApp OTP and reminders in production.
# TWILIO_ACCOUNT_SID=
# Put the Twilio auth token in deploy/secrets/twilio_auth_token.
# TWILIO_WHATSAPP_FROM=whatsapp:+1234567890
# TWILIO_TEMPLATE_OTP_SID=
# TWILIO_TEMPLATE_CONFIRMATION_SID=
# TWILIO_TEMPLATE_REMINDER_SID=
