{$DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 3MB
  }
  reverse_proxy web:3000 {
    header_up X-Real-IP {remote_host}
  }

  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
